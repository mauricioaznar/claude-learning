# Copy to .env and adjust. During dev these point at MinIO (see ../README-dev.md).
# Going to real AWS at the end is a pure .env swap — no code change.

PORT=3003   # distinct from the reference nestjs/ (3002) so both can run at once

# S3 / MinIO connection
S3_ENDPOINT=http://localhost:9000   # MinIO endpoint; leave BLANK for real AWS
S3_REGION=us-east-1
S3_BUCKET=inopack-s3lab-uploads-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true            # true for MinIO, false (or blank) for real AWS

# Upload policy
MAX_FILE_SIZE_BYTES=10485760        # 10 MB — a 10–15pp PDF fits comfortably
ALLOWED_CONTENT_TYPE=application/pdf

# Signed-URL lifetimes (seconds) — keep short
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300
