#!/usr/bin/env bash
# args — the sandbox's measuring tool. YOU write this (part of S1).
#
# It should print exactly what it received:
#   - how many arguments it got
#   - then each argument on the same line, wrapped in angle brackets
#
# Example — `./args one "two three" ""` must print:
#   args count 3: <one> <two three> <>
#
# The brackets are the point: they show where each argument starts and ends,
# including empty ones and ones with spaces. Keep it to a few lines.

printf "args count %d:" "$#"
for word in "$@";
  do
    printf " %s" "<$word>"
done

echo